# meiling-ui 生产部署（nginx）
#
# 部署后验证（在 EC2 上执行，绕过 Cloudflare）：
#   curl -I http://127.0.0.1/ -H 'Host: moli-ui.wu-jinsen.com'
#   curl -I http://127.0.0.1/login -H 'Host: moli-ui.wu-jinsen.com'
#   curl -I -X POST http://127.0.0.1/login -H 'Host: moli-ui.wu-jinsen.com'
#
# 若 / 200 但 /login 404：确认已 reload，且 login 块使用 return 419 → @login_spa → rewrite /

upstream moli_backend {
    server 127.0.0.1:8888;
    keepalive 32;
}

# 知识库服务（与 vite.config.ts 默认一致：去掉 /KnowledgeServer 前缀后转发）
upstream moli_knowledge {
    server 127.0.0.1:8090;
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name moli-ui.wu-jinsen.com;

    root /opt/moli/frontend/dist;
    index index.html;

    error_page 405 = @moli_backend;
    error_page 419 = @login_spa;

    # GET/HEAD /login → 与首页相同走法；POST → 后端
    location = /login {
        if ($request_method = POST) {
            return 405;
        }
        return 419;
    }

    location = /system-select {
        return 419;
    }

    # 内部跳转到 /，复用 location / 的 try_files（不要 rewrite 到 /index.html）
    location @login_spa {
        rewrite ^ / last;
    }

    location @moli_backend {
        proxy_pass http://moli_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header token $http_token;
        proxy_set_header Accept-Language $http_accept_language;
    }

    # 知识库 API：/KnowledgeServer/kb/* → :8090/kb/*（勿打到 8888 用户中心）
    location /KnowledgeServer/ {
        proxy_pass http://moli_knowledge/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header token $http_token;
        proxy_set_header Accept-Language $http_accept_language;
        proxy_read_timeout 300s;
    }

    # API（不含 login）
    location ~ ^/(logout|captchaImage|menu|user|system|sso|dept|post|role|action|auth|dict|config|notice|log|operation|cockpit|bi|persona)(/|$) {
        set $spa_fallback 0;
        if ($request_method ~ ^(GET|HEAD)$) {
            set $spa_fallback 1;
        }
        if ($http_accept ~* text/html) {
            set $spa_fallback "${spa_fallback}1";
        }
        if ($spa_fallback = 11) {
            return 419;
        }

        proxy_pass http://moli_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header token $http_token;
        proxy_set_header Accept-Language $http_accept_language;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?)$ {
        expires 7d;
        access_log off;
    }
}
