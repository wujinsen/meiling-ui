# meiling-ui 生产部署（nginx）
#
# 要点：
# 1. GET /login、/system-select → 必须返回 index.html（后端 /login 只支持 POST）
# 2. GET /system/user 等页面路由 → Accept: text/html 时走 SPA，不能整段反代 /system
# 3. POST /login、fetch API → 反代 8888

upstream moli_backend {
    server 127.0.0.1:8888;
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name moli-ui.wu-jinsen.com;

    root /opt/moli/frontend/dist;
    index index.html;

    # --- 纯前端路由（精确匹配，优先于下方 API 正则）---

    location = /login {
        error_page 405 = @moli_backend;

        set $login_spa 0;
        if ($request_method = GET) {
            set $login_spa 1;
        }
        if ($request_method = HEAD) {
            set $login_spa 1;
        }
        if ($login_spa = 0) {
            return 405;
        }
        try_files /index.html =404;
    }

    location = /system-select {
        try_files /index.html =404;
    }

    location @moli_backend {
        proxy_pass http://moli_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header token $http_token;
        proxy_set_header Accept-Language $http_accept_language;
    }

    # --- API（与 vite.config.ts proxy 一致）---

    location ~ ^/(login|logout|captchaImage|menu|user|system|sso|dept|post|role|action|auth|dict|log|operation|cockpit|bi|persona)(/|$) {
        set $spa_fallback 0;
        if ($request_method ~ ^(GET|HEAD)$) {
            set $spa_fallback 1;
        }
        if ($http_accept ~* text/html) {
            set $spa_fallback "${spa_fallback}1";
        }
        if ($spa_fallback = 11) {
            return 418;
        }

        proxy_pass http://moli_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header token $http_token;
        proxy_set_header Accept-Language $http_accept_language;
    }

    error_page 418 = @spa;

    location @spa {
        try_files /index.html =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
