# false = 登录/退出走真实后端；true = 本地 Mock（admin/123456）
VITE_USE_MOCK_AUTH=false
VITE_API_BASE_URL=

# 知识库联调：不设或 false = 走 8090（或网关）；true = 前端 Mock（含 Tab2 Ingest）
# VITE_USE_MOCK_KNOWLEDGE=false

# T20 Tab1/Tab3（Raw 投喂 · 成品导入）：T20a/T20b 未上线时可单独 Mock，Tab2 仍走真接口
# VITE_MOCK_KB_IMPORT=true
# T20a/T20b 就绪后：VITE_MOCK_KB_IMPORT=false，对照 POST /kb/ingest/raw-upload、/kb/wiki/page/import

# 经网关 21000 转发时：VITE_KB_PROXY_GATEWAY=true
